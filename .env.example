# Database
DATABASE_URL=postgresql://user:password@localhost:5432/financial_health_db

# Flask
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# Wave Apps OAuth
WAVE_CLIENT_ID=your-wave-client-id
WAVE_CLIENT_SECRET=your-wave-client-secret
WAVE_REDIRECT_URI=http://localhost:5000/auth/wave/callback
WAVE_AUTHORIZATION_URL=https://api.waveapps.com/oauth2/authorize/
WAVE_TOKEN_URL=https://api.waveapps.com/oauth2/token/
WAVE_API_URL=https://gql.waveapps.com/graphql/public

# Data Warehouse (example for PostgreSQL, adapt as needed)
DW_HOST=localhost
DW_PORT=5432
DW_DATABASE=financial_dw
DW_USER=dw_user
DW_PASSWORD=dw_password

# Frontend URL
FRONTEND_URL=http://localhost:3000
